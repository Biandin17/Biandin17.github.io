---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout title="SH Events — Steelheads">
  <main class="page-shell">
    <SiteHeader />

    <section class="hero-panel event-page-hero">
      <div class="hero-background"></div>

      <img
        src="/assets/hero-watermark.png"
        alt=""
        class="hero-logo"
        aria-hidden="true"
      />

      <div class="event-announcement-frame">
        <img
          src="/assets/event-soon.png"
          alt="The next event is coming up. More information to be announced soon."
          class="event-announcement"
        />
      </div>
    </section>

    <section class="empty-content-area"></section>

    <ContactSection />
  </main>
</BaseLayout>

<style>
  .event-page-hero {
    min-height: 82vh;
    padding: 40px 24px;
  }

  .event-announcement-frame {
    position: relative;
    z-index: 2;
    display: block;
    width: min(620px, 88vw, 52.3vh);
    line-height: 0;
    background: #ffffff;
    box-shadow: 4px 4px 0 var(--gray);
  }

  .event-announcement {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .event-page-hero {
      min-height: 70vh;
      padding: 28px 16px;
    }

    .event-announcement-frame {
      width: min(520px, 90vw, 48vh);
    }
  }
</style>