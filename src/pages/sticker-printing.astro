---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout title="Sticker Printing — Steelheads">
  <main class="page-shell">
    <SiteHeader />

    <section class="hero-panel sticker-page-hero">
      <div class="hero-background"></div>

      <img
        src="/assets/hero-watermark.png"
        alt=""
        class="hero-logo"
        aria-hidden="true"
      />

      <div class="sticker-introduction">
        <h1>Sticker Printing</h1>

        <p>
          I have been printing stickers for over 7 years and have printed more than
          120'000 of them for various organisations and private individuals. Contact me for more information on prices.
        </p>

        <p>
          I can print both large and small quantities, starting from just one piece.
        </p>
      </div>
    </section>

    <section class="empty-content-area"></section>

    <ContactSection />
  </main>
</BaseLayout>

<style>
  .sticker-page-hero {
    min-height: 68vh;
    padding: 70px 24px;
  }

  .sticker-introduction {
    position: relative;
    z-index: 2;
    width: min(900px, 92vw);
    text-align: center;
  }

  .sticker-introduction h1 {
    display: block;
    margin: 0 0 34px;
    font-family: Candara, "Arial Narrow", Arial, sans-serif;
    font-size: clamp(3.5rem, 9vw, 8rem);
    line-height: 0.84;
    font-style: italic;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--dark);
  }

  .sticker-introduction p {
    max-width: 820px;
    margin: 0 auto;
    font-size: clamp(1.25rem, 2.3vw, 1.9rem);
    line-height: 1.2;
    font-weight: 700;
    color: var(--dark);
  }

  .sticker-introduction p + p {
    margin-top: 24px;
  }

  @media (max-width: 900px) {
    .sticker-page-hero {
      min-height: 62vh;
      padding: 50px 18px;
    }

    .sticker-introduction h1 {
      margin-bottom: 26px;
    }

    .sticker-introduction p + p {
      margin-top: 18px;
    }
  }
</style>