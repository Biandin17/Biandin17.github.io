---
import { getCopy } from '../data/i18n.js';

const { lang = 'it' } = Astro.props;
const copy = getCopy(lang);
---
<section id="contacts" class="contact-section" transition:persist={`contact-section-${lang}`}>
  <div class="contact-strip">
    <h2>{copy.contact.title}</h2>

    <a class="contact-email-button" href="mailto:eric.bianda@unifr.ch">
      eric.bianda@unifr.ch
    </a>

    <div class="contact-details">
      <p>Eric Bianda</p>
      <p>steelheads.events@gmail.com | +41 79 747 42 29</p>
    </div>
  </div>
</section>
