---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getCopy, languagePath, languages } from '../data/i18n.js';

const {
  lang = 'it',
  currentSlug = '',
  title = 'Steelheads Events',
  description = getCopy(lang).meta.description
} = Astro.props;

const canonicalUrl = new URL(languagePath(lang, currentSlug), Astro.site);
const siteName = 'Steelheads Events';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: 'Steelheads',
  url: new URL(languagePath(lang), Astro.site).href,
  inLanguage: lang
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {languages.map((language) => (
      <link
        rel="alternate"
        hreflang={language}
        href={new URL(languagePath(language, currentSlug), Astro.site)}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/it/', Astro.site)} />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {currentSlug === '' && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
    <link
      rel="preload"
      as="image"
      href="/assets/header-background-optimized.png"
      fetchpriority="high"
    />
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
