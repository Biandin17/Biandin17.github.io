---
import {
  getCopy,
  getNavItems,
  languageNames,
  languagePath,
  languages
} from '../data/i18n.js';

const { lang = 'it', currentSlug = '' } = Astro.props;
const copy = getCopy(lang);
const navItems = getNavItems(lang);
---
<header class="top-header" transition:persist={`site-header-${lang}`}>
  <div class="title-line">
    <a href={languagePath(lang)} aria-label={copy.a11y.home} data-astro-prefetch="load">
      <img
        src="/assets/header-logo-optimized.png"
        alt="Steelheads"
        class="title-logo"
        width="1200"
        height="792"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <nav class="language-switcher" aria-label={copy.a11y.languages}>
      {languages.map((language) => (
        <a
          href={languagePath(language, currentSlug)}
          lang={language}
          hreflang={language}
          aria-current={language === lang ? 'page' : undefined}
          aria-label={languageNames[language]}
          data-astro-prefetch="load"
        >
          {language.toUpperCase()}
        </a>
      ))}
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label={copy.a11y.openMenu}
      data-open-label={copy.a11y.openMenu}
      data-close-label={copy.a11y.closeMenu}
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <nav id="main-navigation" class="main-nav" aria-label={copy.a11y.mainNavigation}>
    {navItems.map((item) => (
      <a href={item.href} data-astro-prefetch="load">{item.label}</a>
    ))}
  </nav>

  <noscript>
    <style>
      @media (max-width: 900px) {
        .main-nav { display: flex !important; }
      }
    </style>
  </noscript>
</header>

<script>
  function initialiseMenu() {
    const header = document.querySelector('.top-header:not([data-menu-ready])');
    const menuToggle = header?.querySelector('.menu-toggle');
    const mainNavigation = header?.querySelector('#main-navigation');

    if (!(header instanceof HTMLElement) || !(menuToggle instanceof HTMLButtonElement) || !(mainNavigation instanceof HTMLElement)) return;

    header.dataset.menuReady = 'true';
    const openLabel = menuToggle.dataset.openLabel ?? 'Open menu';
    const closeLabel = menuToggle.dataset.closeLabel ?? 'Close menu';

    const closeMenu = () => {
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', openLabel);
      mainNavigation.classList.remove('is-open');
    };

    menuToggle.addEventListener('click', () => {
      const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? openLabel : closeLabel);
      mainNavigation.classList.toggle('is-open', !isOpen);
    });

    mainNavigation.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenu();
        menuToggle.focus();
      }
    });
  }

  document.addEventListener('astro:page-load', initialiseMenu);
  initialiseMenu();
</script>
