---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getCopy, languagePath, languages } from '../data/i18n.js';

const {
  lang = 'it',
  currentSlug = '',
  title = 'Steelheads',
  description = getCopy(lang).meta.description
} = Astro.props;

const canonicalUrl = new URL(languagePath(lang, currentSlug), Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {languages.map((language) => (
      <link
        rel="alternate"
        hreflang={language}
        href={new URL(languagePath(language, currentSlug), Astro.site)}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/it/', Astro.site)} />
    <link rel="icon" href="/favicon.svg" />
    <link
      rel="preload"
      as="image"
      href="/assets/header-background-optimized.png"
      fetchpriority="high"
    />
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
