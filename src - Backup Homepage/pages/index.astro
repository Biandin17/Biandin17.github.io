---
import BaseLayout from '../layouts/BaseLayout.astro';

const navItems = [
  { label: 'Home', href: '#home' },
  { label: 'SH Events', href: '#sh-events' },
  { label: 'Grafic Designer', href: '#grafic-designer' },
  { label: 'Sticker Printing', href: '#sticker-printing' },
  { label: 'Hostile Wear', href: '#hostile-wear' },
  { label: 'Custom clothes', href: '#custom-clothes' },
  { label: 'About me', href: '#about-me' },
  { label: 'Contacts', href: '#contacts' }
];

const blocks = [
  { id: 'sh-events', title: 'SH Events', text: 'Events and parties organised by Steelheads. Ask about partnerships or let’s work together to bring new ideas to life!' },
  { id: 'grafic-designer', title: 'Grafic Designer', text: 'I design: logos, flyers, visuals and various graphics for digital content. ' },
  { id: 'sticker-printing', title: 'Sticker Printing', text: 'I design and print stickers for every occasion: for indoor and outdoor use, in custom shapes, and in both small and large quantities.' },
  { id: 'hostile-wear', title: 'Hostile Wear', text: 'Hostile Wear is my clothing brand, with hand-embroidered pieces.' },
  { id: 'custom-clothes', title: 'Custom clothes', text: 'I create customised clothing, whether individual pieces or outfits for groups and events, using a various production methods.' },
  { id: 'about-me', title: 'About me', text: 'Find out more about who I am and what Steelheads is.' }
];
---

<BaseLayout title="Steelheads Events — Official Site">
  <main id="home" class="page-shell">
    <header class="top-header">
      <div class="title-line">
        <img src="/assets/header-logo.png" alt="Steelheads" class="title-logo" />
      </div>

      <nav class="main-nav" aria-label="Sezioni principali">
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>

    <section class="hero-panel">
      <div class="hero-background"></div>
      <img src="/assets/hero-watermark.png" alt="" class="hero-logo" aria-hidden="true" />
      <div class="hero-copy">
        <h1>
          <span class="hero-title-main">Steelheads</span>
          <span class="hero-title-sub">by Bianda</span>
        </h1>
        <p>
          Events, Graphics, Customisation, and much more!
        </p>
      </div>
    </section>

    <section class="section-grid">
      {blocks.map((block) => (
        <article class="content-card" id={block.id}>
          <h2>{block.title}</h2>
          <p>{block.text}</p>
        </article>
      ))}
    </section>

    <section id="contacts" class="contact-section">
      <div class="contact-strip">
        <h2>Contact me</h2>

        <a href="mailto:hello@steelheads.ch">
          eric.bianda@unifr.ch
        </a>
        
        <div class="contact-details">
          <p>Eric Bianda</p>
          <p>eric.bianda@unifr.ch | +41 79 747 42 29</p>
        </div>   
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :root {
    color-scheme: light;
    --white: #ffffff;
    --black: #000000;
    --dark: #333333;
    --gray: #6f6f6f;
    --light: #d6d8d6;
    --line: rgba(0, 0, 0, 0.72);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: Candara, "Arial Narrow", Arial, sans-serif;
    font-style: italic;
    background: var(--light);
    color: var(--dark);
  }
  a { color: inherit; text-decoration: none; }

  .page-shell {
    min-height: 100vh;
    background:
      linear-gradient(rgba(214,216,214,0.82), rgba(214,216,214,0.82)),
      url('/assets/steel.png') center / cover fixed;
  }

  .top-header {
    background: rgba(214,216,214,0.92);
    border-bottom: 6px solid var(--dark);
    box-shadow: none;
  }

  .title-line {
  min-height: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px 24px;
  background: url('/assets/header-background.png?v=2') center / 100% 100% no-repeat;
  }

  .title-logo {
  width: min(900px, 90vw);
  height: 110px;
  object-fit: contain;
  object-position: center;
  }

  .main-nav {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: 14px 20px;
    border-top: 6px solid var(--dark);
    background: rgba(214,216,214,0.72);
  }

  .main-nav a {
    position: relative;
    z-index: 1;
    padding: 9px 18px;
    color: var(--dark);
    font-size: clamp(1rem, 1.8vw, 1.45rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    transition: color .2s ease;
  }
  .main-nav a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--black);
    transform: skewX(-21.3deg) scaleX(0);
    transform-origin: center;
    transition: transform .2s ease;
  }

  .main-nav a::after {
    content: "";
    position: absolute;
    top: 10%;
    right: 0;
    width: 2px;
    height: 80%;
    background: rgba(0, 0, 0, 0.35);
    transform: skewX(-21.3deg);
    transform-origin: center;
    z-index: 2;
  }

  .main-nav a:last-child::after {
    display: none;
  }

  .main-nav a:hover,
  .main-nav a:focus-visible {
    color: var(--white);
  }

  .main-nav a:hover::before,
  .main-nav a:focus-visible::before {
    transform: skewX(-21.3deg) scaleX(1);
  }

  .hero-panel {
    position: relative;
    min-height: 68vh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 70px 24px;
    border-bottom: 6px solid var(--dark);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(214,216,214,0.58), rgba(214,216,214,0.78)),
      url('/assets/steel.png') center / cover;
    filter: grayscale(1);
  }

  .hero-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(900px, 82vw);
    max-height: calc(100% - 80px);
    height: auto;
    opacity: 0.22;
    transform: translate(-50%, -50%);
    filter: none;
    object-fit: contain;
    object-position: center;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    width: min(980px, 94vw);
    text-align: center;
    padding: 30px;
  }

  .small-label,
  .content-card span,
  .contact-strip span {
    display: block;
    margin-bottom: 12px;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    color: var(--dark);
  }

  h1,
  h2,
  p { margin: 0; }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--dark);
    font-family: Candara, "Arial Narrow", Arial, sans-serif;
    font-style: italic;
    font-weight: 700;
    text-align: center;
  }

  .hero-title-main {
    display: block;
    font-size: clamp(4rem, 11vw, 9rem);
    line-height: 0.86;
    letter-spacing: 0.01em;
    font-weight: 1200;
    text-transform: none;
  }

  .hero-title-sub {
    display: block;
    margin-top: 0.08em;
    font-size: clamp(2rem, 5vw, 4.3rem);
    line-height: 0.9;
    letter-spacing: 0.055em;
    text-transform: none;
  }

  .hero-copy p:last-child {
    max-width: 760px;
    margin: 28px auto 0;
    font-size: clamp(1.35rem, 2.6vw, 2.2rem);
    line-height: 1.05;
    font-weight: 700;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 34px 24px;
  }

  .content-card {
    border: 5px solid var(--dark);
    background: rgba(255,255,255,0.58);
    box-shadow: 4px 4px 0 var(--gray);
  }

  .content-card {
    min-height: 260px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    transition: transform .2s ease, background .2s ease;
  }

  .content-card:hover {
    transform: translate(-4px, -4px);
    background: rgba(0,0,0,0.88);
    color: var(--white);
  }

  .content-card:hover span,
  .content-card:hover p { color: var(--white); }

  h2 {
    font-size: clamp(2.2rem, 5vw, 4.8rem);
    line-height: .82;
    font-weight: 900;
    letter-spacing: -0.08em;
    text-transform: uppercase;
  }

  .content-card p,
  .contact-strip p {
    margin-top: 18px;
    font-size: 1.25rem;
    line-height: 1.22;
    font-weight: 700;
  }

  .contact-section {
    width: 100%;
    border-top: 6px solid var(--dark);
    padding: 34px 24px 40px;
    background: url('/assets/header-background.png?v=2') center / 100% 100% no-repeat;
  }

  .contact-strip {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0px 0 0px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 16px;
  }

  .contact-strip a {
    flex: 0 0 auto;
    padding: 14px 22px;
    background: var(--black);
    color: var(--white);
    font-size: 1.4rem;
    font-weight: 900;
    text-transform: uppercase;
  }
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: -6px;
  }

  .contact-details p {
    margin: 0;
  }
  @media (max-width: 900px) {
    .title-line { min-height: 110px; }
    .main-nav { justify-content: flex-start; }
    .main-nav a { border-right: 0; }
    .section-grid { grid-template-columns: 1fr; }
    .contact-strip { flex-direction: column; align-items: flex-start; }
    .hero-panel { min-height: 58vh; }
  }
</style>
