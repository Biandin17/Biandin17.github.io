---
import BaseLayout from '../layouts/BaseLayout.astro';

const navItems = [
  { label: 'Home', href: '#home' },
  { label: 'SH Events', href: '#sh-events' },
  { label: 'Grafic Designer', href: '#grafic-designer' },
  { label: 'Sticker Printing', href: '#sticker-printing' },
  { label: 'Hostile Wear', href: '#hostile-wear' },
  { label: 'Custom clothes', href: '#custom-clothes' },
  { label: 'About me', href: '#about-me' },
  { label: 'Contacts', href: '#contacts' }
];

const blocks = [
  { id: 'sh-events', title: 'SH Events', text: 'Eventi, serate, collaborazioni e format firmati Steelheads.' },
  { id: 'grafic-designer', title: 'Grafic Designer', text: 'Loghi, visual, poster, identità grafiche e contenuti digitali.' },
  { id: 'sticker-printing', title: 'Sticker Printing', text: 'Stickers personalizzati, grafiche adesive, piccoli batch e produzioni su richiesta.' },
  { id: 'hostile-wear', title: 'Hostile Wear', text: 'Archivio e collegamento al progetto Hostile Wear.' },
  { id: 'custom-clothes', title: 'Custom clothes', text: 'Vestiti custom, pezzi unici, idee, prove e drop speciali.' },
  { id: 'about-me', title: 'About me', text: 'Chi sono, cosa faccio e perché esiste Steelheads.' }
];
---

<BaseLayout title="Steelheads Events — Official Site">
  <main id="home" class="page-shell">
    <header class="top-header">
      <div class="title-line">
        <img src="/assets/sh-events.png" alt="Steelheads Events" class="title-logo" />
      </div>

      <nav class="main-nav" aria-label="Sezioni principali">
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>

    <section class="hero-panel">
      <div class="hero-background"></div>
      <img src="/assets/sh-logo-grigio.png" alt="SH Steelheads" class="hero-logo" />
      <div class="hero-copy">
        <p class="small-label">Official Archive / Events / Design</p>
        <h1>Steelheads Events</h1>
        <p>
          Uno spazio personale per raccogliere eventi, grafica, stampa stickers,
          custom clothes, Hostile Wear e progetti creativi.
        </p>
      </div>
    </section>

    <section class="section-grid">
      {blocks.map((block) => (
        <article class="content-card" id={block.id}>
          <span>Steelheads / {block.title}</span>
          <h2>{block.title}</h2>
          <p>{block.text}</p>
        </article>
      ))}
    </section>

    <section id="contacts" class="contact-strip">
      <div>
        <span>Contacts</span>
        <h2>Get in touch</h2>
        <p>Aggiungi qui email, Instagram, link Hostile Wear, portfolio e altri contatti.</p>
      </div>
      <a href="mailto:hello@steelheads.ch">hello@steelheads.ch</a>
    </section>
  </main>
</BaseLayout>

<style>
  :root {
    color-scheme: light;
    --white: #ffffff;
    --black: #000000;
    --dark: #333333;
    --gray: #6f6f6f;
    --light: #d6d8d6;
    --line: rgba(0, 0, 0, 0.72);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: Candara, "Arial Narrow", Arial, sans-serif;
    font-style: italic;
    background: var(--light);
    color: var(--dark);
  }
  a { color: inherit; text-decoration: none; }

  .page-shell {
    min-height: 100vh;
    background:
      linear-gradient(rgba(214,216,214,0.82), rgba(214,216,214,0.82)),
      url('/assets/steel.png') center / cover fixed;
  }

  .top-header {
    background: rgba(214,216,214,0.92);
    border-bottom: 8px solid var(--dark);
    box-shadow: 0 6px 0 var(--gray);
  }

  .title-line {
    min-height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 26px 24px 18px;
  }

  .title-logo {
    width: min(860px, 92vw);
    max-height: 120px;
    object-fit: contain;
    filter: contrast(1.08);
  }

  .main-nav {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: 14px 20px;
    border-top: 6px solid var(--dark);
    background: rgba(214,216,214,0.72);
  }

  .main-nav a {
    padding: 9px 15px;
    color: var(--dark);
    font-size: clamp(1rem, 1.8vw, 1.45rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    border-right: 2px solid rgba(0,0,0,0.35);
    transition: background .2s ease, color .2s ease, transform .2s ease;
  }

  .main-nav a:last-child { border-right: 0; }
  .main-nav a:hover {
    background: var(--black);
    color: var(--white);
    transform: skewX(-8deg);
  }

  .hero-panel {
    position: relative;
    min-height: 68vh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 70px 24px;
    border-bottom: 6px solid var(--dark);
  }

  .hero-background {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(214,216,214,0.58), rgba(214,216,214,0.78)),
      url('/assets/steel.png') center / cover;
    filter: grayscale(1);
  }

  .hero-logo {
    position: absolute;
    width: min(980px, 115vw);
    opacity: 0.28;
    transform: rotate(-1deg) scale(1.12);
    filter: grayscale(1) contrast(1.1);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    width: min(980px, 94vw);
    text-align: center;
    padding: 30px;
  }

  .small-label,
  .content-card span,
  .contact-strip span {
    display: block;
    margin-bottom: 12px;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    color: var(--dark);
  }

  h1,
  h2,
  p { margin: 0; }

  h1 {
    font-size: clamp(4.2rem, 13vw, 12rem);
    line-height: .78;
    font-weight: 900;
    letter-spacing: -0.09em;
    color: var(--dark);
    text-transform: uppercase;
  }

  .hero-copy p:last-child {
    max-width: 760px;
    margin: 28px auto 0;
    font-size: clamp(1.35rem, 2.6vw, 2.2rem);
    line-height: 1.05;
    font-weight: 700;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 1240px;
    margin: 0 auto;
    padding: 34px 24px;
  }

  .content-card,
  .contact-strip {
    border: 5px solid var(--dark);
    background: rgba(255,255,255,0.58);
    box-shadow: 8px 8px 0 var(--gray);
  }

  .content-card {
    min-height: 260px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    transition: transform .2s ease, background .2s ease;
  }

  .content-card:hover {
    transform: translate(-4px, -4px);
    background: rgba(0,0,0,0.88);
    color: var(--white);
  }

  .content-card:hover span,
  .content-card:hover p { color: var(--white); }

  h2 {
    font-size: clamp(2.2rem, 5vw, 4.8rem);
    line-height: .82;
    font-weight: 900;
    letter-spacing: -0.08em;
    text-transform: uppercase;
  }

  .content-card p,
  .contact-strip p {
    margin-top: 18px;
    font-size: 1.25rem;
    line-height: 1.22;
    font-weight: 700;
  }

  .contact-strip {
    max-width: 1240px;
    margin: 0 auto 40px;
    padding: 30px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .contact-strip a {
    flex: 0 0 auto;
    padding: 14px 22px;
    background: var(--black);
    color: var(--white);
    font-size: 1.4rem;
    font-weight: 900;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .title-line { min-height: 110px; }
    .main-nav { justify-content: flex-start; }
    .main-nav a { border-right: 0; }
    .section-grid { grid-template-columns: 1fr; }
    .contact-strip { flex-direction: column; align-items: flex-start; }
    .hero-panel { min-height: 58vh; }
  }
</style>
